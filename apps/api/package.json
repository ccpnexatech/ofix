{
  "name": "@ofix/api",
  "version": "0.0.0",
  "private": true,
  "description": "OFIX REST API (NestJS)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "DISABLE_ERD=true prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:erd": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@ofix/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.3",
    "@ofix/config": "workspace:*",
    "@swc/core": "^1.12.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.28.0",
    "prisma": "^6.19.3",
    "prisma-erd-generator": "^2.4.3",
    "supertest": "^7.2.2",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.4",
    "vitest": "^3.2.3"
  }
}
