# Runtime
NODE_ENV=development
PORT=3001

# Auth (ADR-008) — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars
# Web app origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Database (docker compose up -d)
DATABASE_URL=postgresql://ofix:ofix@localhost:5432/ofix
# Disposable test database (port 5433) used by integration tests
DATABASE_URL_TEST=postgresql://ofix:ofix@localhost:5433/ofix_test
