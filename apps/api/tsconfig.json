{
  "extends": "@ofix/config/typescript/base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@api/*": ["src/*"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
