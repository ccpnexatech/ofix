{
  "name": "ofix",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-tenant service order management for repair shops",
  "author": "Caio César Passos Viana Ponte",
  "license": "MIT",
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @ofix/api db:migrate",
    "db:studio": "pnpm --filter @ofix/api db:studio",
    "db:erd": "pnpm --filter @ofix/api db:erd",
    "db:seed": "tsx scripts/seed-demo.ts",
    "test:e2e": "playwright test",
    "shots": "SHOTS_ONLY=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "turbo": "^2.5.4"
  }
}
